<mujoco model="IEO Humanoid body">

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="127" height="1278"
             rgb1="1 .35 .05" rgb2="1 .35 .05" markrgb="1 1 1" random="0.01"/>
    <material name="body" texture="body" texuniform="true" rgba="1 .35 .05 1"/>
    <material name="club" rgba="0.12 0.12 0.12 1"/>
    <material name="ball" rgba="0.95 0.95 0.95 1"/>
    <material name="grass" rgba="0.15 0.55 0.12 1" reflectance="0.05"/>
    <mesh name="golf_club_mesh" file="golf_club.stl" scale="0.0103 0.0103 0.0103"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <default>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <default class="body">
      <geom type="capsule" condim="1" friction=".7" solimp=".9 .99 .003" solref=".015 1" material="body"/>
      <joint type="hinge" damping="15" stiffness="80" armature=".01" limited="true" solimplimit="0 .99 .01"/>
      <default class="big_joint">
        <joint damping="20" stiffness="100"/>
        <default class="big_stiff_joint">
          <joint damping="25" stiffness="140"/>
        </default>
      </default>
    </default>
  </default>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global offwidth="800" offheight="800"/>
  </visual>

  <worldbody>

    <!-- Câmara fixa em +X, voltada para a frente do jogador. -->
    <camera name="front_fixed" pos="3.3 0 1.1" xyaxes="0 1 0 0 0 1" fovy="50"/>

    <!-- CHÃO -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grass" contype="1" conaffinity="1"/>

    <!-- Bola centrada à frente do jogador, apoiada no chão. -->
    <body name="golf_ball" pos="0.85 0.042 0.022">
      <freejoint name="golf_ball_free"/>
      <geom name="golf_ball_geom" type="sphere" size="0.0213" mass="0.046" material="ball"/>
    </body>

    <body name="torso" pos="0 0 1.22" childclass="body">
      <camera name="back" pos="-3 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -3 1" xyaxes="1 0 0 0 1 2" mode="trackcom"/>
      <freejoint name="root"/>

      <!-- CINTURA -->
      <body name="lower_waist" pos="-.01 0 -.26">
        <geom name="lower_waist" fromto="0 -.06 0 0 .06 0" size=".06"/>

        <!-- PELVE -->
        <body name="pelvis" pos="0 0 -.165">
          <geom name="butt" fromto="-.02 -.07 0 -.02 .07 0" size=".09"/>

          <!-- PERNA DIREITA FIXA -->
          <body name="right_thigh" pos="0 -.08 -.04">
            <geom name="right_thigh" fromto="0 0 0 0 -.04 -.35" size=".06"/>
            <body name="right_shin" pos="0 -.04 -.388">
              <geom name="right_shin" fromto="0 0 0 0 -.04 -.31" size=".049"/>
              <body name="right_foot" pos="0 -.04 -.375">
                <geom name="right_right_foot" fromto="-.07 -.02 0 .14 -.04 0" size=".027"/>
                <geom name="left_right_foot" fromto="-.07 0 0 .14 .02 0" size=".027"/>
              </body>
            </body>
          </body>

          <!-- PERNA ESQUERDA FIXA -->
          <body name="left_thigh" pos="0 .08 -.04">
            <geom name="left_thigh" fromto="0 0 0 0 .04 -.35" size=".06"/>
            <body name="left_shin" pos="0 .04 -.388">
              <geom name="left_shin" fromto="0 0 0 0 .04 -.31" size=".049"/>
              <body name="left_foot" pos="0 .04 -.375">
                <geom name="left_left_foot" fromto="-.07 .02 0 .14 .04 0" size=".027"/>
                <geom name="right_left_foot" fromto="-.07 0 0 .14 -.02 0" size=".027"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- O swing roda em torno de um eixo vertical, antes da inclinação do tronco. -->
      <body name="swing_axis" pos="-.01 0 -.29">
        <joint name="torso_turn" type="hinge" axis="0 0 1" range="-65 50" damping="20"/>
      <body name="upper_torso" quat=".994522 0 .15 0">
        <geom name="spine" fromto="0 0 0 .01 0 .26" size=".055" rgba="0 0 0 0"/>
        <geom name="torso" fromto=".01 -.07 .26 .01 .07 .26" size=".07"/>
        <geom name="upper_waist" fromto="0 -.06 .14 0 .06 .14" size=".06"/>

        <!-- CABEÇA -->
        <body name="head" pos=".01 0 .45">
          <geom name="head" type="sphere" size=".09"/>
          <camera name="egocentric" pos=".09 0 0" xyaxes="0 -1 0 .1 0 1" fovy="80"/>
        </body>

      <!-- BRAÇO DIREITO -->
      <body name="right_upper_arm" pos=".01 -.17 .32">
        <joint name="right_shoulder1" axis="2 1 1" range="-85 60"/>
        <joint name="right_shoulder2" axis="0 -1 1" range="-85 60"/>
        <geom name="right_upper_arm" fromto="0 0 0 .18 .05 -.15" size=".04"/>
        <body name="right_lower_arm" pos=".18 .05 -.15">
          <!-- Cotovelo fixo; sem DOF. -->
          <geom name="right_lower_arm" fromto="0 0 0 .18 .12 -.04" size=".031"/>
          <body name="right_hand" pos=".18 .12 -.04" quat="0.97 -0.01 0.25881905 0">
            <!-- A mão mantém a pega; apenas o pulso tem DOF. -->
            <joint name="right_wrist_x" axis="1 0 0" range="-45 45"/>
            <joint name="right_wrist_y" axis="0 1 0" range="-60 45"/>
            <geom name="right_hand" type="sphere" size=".04"/>
            <site name="shared_grip" size=".008" rgba="0 0 0 0"/>
            <site name="club_head" pos=".989 .010 -.286" size=".008" rgba="1 0 0 .7"/>
            <!-- TACO DE GOLFE -->
            <geom
              name="golf_club"
              type="mesh"
              mesh="golf_club_mesh"
              material="club"
              pos="0.9751 0 -0.327"
              quat="0.88295 0 -0.46947 0"
              contype="1"
              conaffinity="1"
            />
          </body>
        </body>
      </body>

      <!-- BRAÇO ESQUERDO -->
      <body name="left_upper_arm" pos=".01 .17 .32">
        <joint name="left_shoulder1" axis="2 -1 1" range="-60 85"/>
        <joint name="left_shoulder2" axis="0 1 1" range="-60 85"/>
        <geom name="left_upper_arm" fromto="0 0 0 .18 -.05 -.15" size=".04"/>
        <body name="left_lower_arm" pos=".18 -.05 -.15">
          <!-- Cotovelo fixo; sem DOF. -->
          <geom name="left_lower_arm" fromto="0 0 0 .18 -.12 -.04" size=".031"/>
          <site name="left_grip" pos=".18 -.12 -.04" size=".008" rgba="0 0 0 0"/>
        </body>
      </body>
      </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect site1="left_grip" site2="shared_grip" solref=".002 1" solimp=".99 .999 .001"/>
  </equality>

  <actuator>
    <motor name="torso_turn_motor" joint="torso_turn" ctrlrange="-250 250"/>
    <motor name="right_shoulder1_motor" joint="right_shoulder1" ctrlrange="-180 180"/>
    <motor name="right_shoulder2_motor" joint="right_shoulder2" ctrlrange="-180 180"/>
    <motor name="right_wrist_x_motor" joint="right_wrist_x" ctrlrange="-90 90"/>
    <motor name="right_wrist_y_motor" joint="right_wrist_y" ctrlrange="-90 90"/>
    <motor name="left_shoulder1_motor" joint="left_shoulder1" ctrlrange="-180 180"/>
    <motor name="left_shoulder2_motor" joint="left_shoulder2" ctrlrange="-180 180"/>
  </actuator>

</mujoco>
