<mujoco model="IEO Humanoid body">

  <!-- Resolve head/ball contact with 0.5 ms steps; see validation script. -->
  <option timestep="0.0005" gravity="0 0 -50.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="127" height="1278"
             rgb1="1 .35 .05" rgb2="1 .35 .05" markrgb="1 1 1" random="0.01"/>
    <material name="body" texture="body" texuniform="true" rgba="1 .35 .05 1"/>
    <material name="club" rgba="0.12 0.12 0.12 1"/>
    <material name="ball" rgba="0.95 0.95 0.95 1"/>
    <material name="grass" rgba="0.15 0.55 0.12 1" reflectance="0.05"/>
    <mesh name="golf_club_mesh" file="golf_club.stl" scale="0.0103 0.0103 0.0103"/>
    <mesh name="golf_club_head_mesh" file="golf_club_head.stl" inertia="convex"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <default>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <default class="body">
      <!-- Explicit geom masses: each leg 11 kg (thigh + shin), each foot 1 kg,
           torso including waist/pelvis 30 kg, each arm 3 kg, head 5 kg.
           Player total = 65 kg, excluding club and ball. Within each group,
           segment masses preserve the previous geometric proportions. -->
      <geom type="capsule" condim="1" friction=".7" solimp=".9 .99 .003" solref=".015 1" material="body"/>
      <joint type="hinge" damping="2" stiffness="0" armature=".01" limited="true" solimplimit="0 .99 .01"/>
      <default class="big_joint">
        <joint damping="20" stiffness="100"/>
        <default class="big_stiff_joint">
          <joint damping="25" stiffness="140"/>
        </default>
      </default>
    </default>
  </default>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global offwidth="800" offheight="800"/>
  </visual>

  <worldbody>

    <!-- Câmara fixa em +X, voltada para a frente do jogador. -->
    <camera name="front_fixed" pos="3.3 0 1.1" xyaxes="0 1 0 0 0 1" fovy="50"/>

    <!-- CHÃO -->
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.75 0.9 0.75 1" contype="1" conaffinity="1"/>

    <!-- Bola centrada à frente do jogador, apoiada no chão. -->
    <body name="golf_ball" pos="0.85 0.042 0.022">
      <freejoint name="golf_ball_free"/>
      <geom name="golf_ball_geom" type="sphere" size="0.0213" mass="0.046" material="ball"/>
    </body>

    <!-- Fixed lower body: an arm-motion demonstration, not a balance model. -->
    <body name="torso" pos="0 0 1.255" childclass="body">
      <camera name="back" pos="-3 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -3 1" xyaxes="1 0 0 0 1 2" mode="trackcom" fovy="55"/>

      <!-- CINTURA -->
      <body name="lower_waist" pos="-.01 0 -.26">
        <geom name="lower_waist" fromto="0 -.06 0 0 .06 0" size=".06" mass="3.790639"/>

        <!-- PELVE -->
        <body name="pelvis" pos="0 0 -.165">
          <geom name="butt" fromto="-.02 -.07 0 -.02 .07 0" size=".09" mass="11.087618"/>

          <!-- PERNA DIREITA FIXA -->
          <body name="right_thigh" pos="0 -.08 -.04">
            <geom name="right_thigh" fromto="0 0 0 0 -.04 -.35" size=".06" mass="6.948605"/>
            <body name="right_shin" pos="0 -.04 -.388">
              <geom name="right_shin" fromto="0 0 0 0 -.04 -.31" size=".049" mass="4.051395"/>
              <body name="right_foot" pos="0 -.04 -.375">
                <geom name="right_right_foot" fromto="-.07 -.02 0 .14 -.04 0" size=".027" mass="0.5"/>
                <geom name="left_right_foot" fromto="-.07 0 0 .14 .02 0" size=".027" mass="0.5"/>
              </body>
            </body>
          </body>

          <!-- PERNA ESQUERDA FIXA-->
          <body name="left_thigh" pos="0 .08 -.04">
            <geom name="left_thigh" fromto="0 0 0 0 .04 -.35" size=".06" mass="6.948605"/>
            <body name="left_shin" pos="0 .04 -.388">
              <geom name="left_shin" fromto="0 0 0 0 .04 -.31" size=".049" mass="4.051395"/>
              <body name="left_foot" pos="0 .04 -.375">
                <geom name="left_left_foot" fromto="-.07 .02 0 .14 .04 0" size=".027" mass="0.5"/>
                <geom name="right_left_foot" fromto="-.07 0 0 .14 -.02 0" size=".027" mass="0.5"/>
              </body>
            </body>
          </body>
          
        </body>
      </body>

      <!-- O swing roda em torno de um eixo vertical, antes da inclinação do tronco. -->
      <body name="swing_axis" pos="-.01 0 -.29">
        <joint name="torso_turn" type="hinge" axis="0 0 1" range="-90 90" damping="5"/>
      <body name="upper_torso" quat=".994522 0 .15 0">
        <geom name="spine" fromto="0 0 0 .01 0 .26" size=".055" rgba="0 0 0 0" mass="5.311711"/>
        <geom name="torso" fromto=".01 -.07 .26 .01 .07 .26" size=".07" mass="6.019394"/>
        <geom name="upper_waist" fromto="0 -.06 .14 0 .06 .14" size=".06" mass="3.790638"/>

        <!-- CABEÇA -->
        <body name="head" pos=".01 0 .45">
          <geom name="head" type="sphere" size=".09" mass="5"/>
          <camera name="egocentric" pos=".09 0 0" xyaxes="0 -1 0 .1 0 1" fovy="80"/>
        </body>

      <!-- BRAÇO DIREITO -->
      <!-- Three shoulder rotations; independent elbow flexion below. -->
      <body name="right_upper_arm" pos=".01 -.17 .32">
        <joint name="right_arm_lift" axis="0 1 0" range="-170 90"/>
        <joint name="right_shoulder1" axis="1 0 0" range="-170 170"/>
        <joint name="right_shoulder2" axis="0 0 1" range="-170 170"/>
        <geom name="right_upper_arm" fromto="0 0 0 .18 .05 -.15" size=".04" mass="1.746276"/>
        <body name="right_lower_arm" pos=".18 .05 -.15">
          <joint name="right_elbow" axis=".016 -.0198 .0126" range="-32.6 110" stiffness="0" damping="2"/>
          <!-- Elbow hinge: zero retains the initial 32.61 degree bend. -->
          <geom name="right_lower_arm" fromto="0 0 0 .18 .12 -.04" size=".031" mass="0.935767"/>
          <body name="right_hand" pos=".18 .12 -.04" quat="0.97 -0.01 0.25881905 0">
            <!-- A mão mantém a pega; apenas o pulso tem DOF. -->
            <joint name="right_wrist_cock" axis="0 0 1" range="-150 150" stiffness="0" damping="2"/>
            <!-- Second wrist rotation controls club deviation. -->
            <joint name="right_wrist_deviation" axis="0 1 0" range="-120 100" stiffness="0" damping="2"/>
            <geom name="right_hand" type="sphere" size=".04" mass="0.317957"/>
            <site name="shared_grip" size=".008" rgba="0 0 0 0"/>
            <site name="club_head" pos=".989 .010 -.286" size=".008" rgba="1 0 0 .7"/>
            <!-- TACO DE GOLFE -->
            <geom
              name="golf_club"
              type="mesh"
              density="1000"
              mesh="golf_club_mesh"
              material="club"
              pos="0.9751 0 -0.327"
              quat="0.88295 0 -0.46947 0"
              contype="0"
              conaffinity="0"
            />
            <!-- Separate head and shaft collision shapes avoid the invisible
                 solid wedge made by the convex hull of the entire club.
                 Mass stays on the supplied visual mesh; colliders add none. -->
            <geom name="club_head_collision" type="mesh" mesh="golf_club_head_mesh"
                  mass="0" rgba="0 0 0 0"/>
            <geom name="club_shaft_collision" type="capsule" fromto="-.04 0 .014 .975 0 -.315"
                  size=".006" mass="0" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- BRAÇO ESQUERDO -->
      <body name="left_upper_arm" pos=".01 .17 .32">
        <joint name="left_arm_lift" axis="0 1 0" range="-170 90"/>
        <joint name="left_shoulder1" axis="1 0 0" range="-170 170"/>
        <joint name="left_shoulder2" axis="0 0 1" range="-170 170"/>
        <geom name="left_upper_arm" fromto="0 0 0 .18 -.05 -.15" size=".04" mass="1.953298"/>
        <body name="left_lower_arm" pos=".18 -.05 -.15">
          <joint name="left_elbow" axis="-.016 -.0198 -.0126" range="-32.6 110" stiffness="0" damping="2"/>
          <!-- Elbow hinge: zero retains the initial 32.61 degree bend. -->
          <geom name="left_lower_arm" fromto="0 0 0 .18 -.12 -.04" size=".031" mass="1.046702"/>
          <site name="left_grip" pos=".18 -.12 -.04" size=".008" rgba="0 0 0 0"/>
        </body>
      </body>
      </body>
      </body>
    </body>
  </worldbody>

  <!-- The simplified forearms meet at one shared grip. Their overlapping
       end capsules and the held club must not repel one another there.
       The adjoining waist shapes are excluded below too. Club/ball and
       club/floor contacts remain enabled. -->
  <contact>
    <!-- A short, underdamped contact response for the head hitting the ball.
         This is a simulation parameter, not a measured restitution value. -->
    <pair geom1="club_head_collision" geom2="golf_ball_geom" condim="3"
          friction=".3 .3 .005 .0001 .0001" solref=".003 .35" solimp=".95 .99 .001"/>
    <!-- Adjacent waist shapes overlap at their intended pivot. With a fixed
         base these need explicit exclusions to let the torso turn. -->
    <exclude body1="lower_waist" body2="upper_torso"/>
    <exclude body1="pelvis" body2="upper_torso"/>
    <exclude body1="right_lower_arm" body2="left_lower_arm"/>
    <exclude body1="right_hand" body2="left_lower_arm"/>
  </contact>

  <equality>
    <connect site1="left_grip" site2="shared_grip" solref=".002 1" solimp=".99 .999 .001"/>
  </equality>

  <actuator>
    <motor name="right_elbow_motor" joint="right_elbow" ctrlrange="-90 90"/>
    <motor name="left_elbow_motor" joint="left_elbow" ctrlrange="-90 90"/>
    <motor name="right_arm_lift_motor" joint="right_arm_lift" ctrlrange="-180 180"/>
    <motor name="left_arm_lift_motor" joint="left_arm_lift" ctrlrange="-180 180"/>
    <motor name="torso_turn_motor" joint="torso_turn" ctrlrange="-250 250"/>
    <motor name="right_shoulder1_motor" joint="right_shoulder1" ctrlrange="-180 180"/>
    <motor name="right_shoulder2_motor" joint="right_shoulder2" ctrlrange="-180 180"/>
    <motor name="right_wrist_cock_motor" joint="right_wrist_cock" ctrlrange="-90 90"/>
    <motor name="right_wrist_deviation_motor" joint="right_wrist_deviation" ctrlrange="-90 90"/>
    <motor name="left_shoulder1_motor" joint="left_shoulder1" ctrlrange="-180 180"/>
    <motor name="left_shoulder2_motor" joint="left_shoulder2" ctrlrange="-180 180"/>
  </actuator>

</mujoco>
