<mujoco model="pendulum">

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>

    <light name="top" pos="0 0 2"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0 0 0.8 1"/>

    <body name="pivot">

      <body name="bob" pos="0 0 0">
        <geom name="rod"  type="capsule" fromto="0 0 0  0 0 -0.5" size="0.02" rgba="0.3 0.3 0.9 1"/>      
        <joint name="hinge" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <geom name="mass" type="sphere"  pos="0 0 -0.5" size="0.05" rgba="0.9 0.2 0.2 1"/>  
      </body>    
      

    </body>

  </worldbody>

</mujoco>

