<mujoco model="arm2">

  <!-- ==================================================================
       STAGE 1: KINEMATICS ONLY.
       Gravity is OFF. Nothing here moves by itself. The arm sits exactly
       where we put it by writing joint angles. This isolates the geometry
       so we can verify the IK math with no dynamics confusing the picture.
       ================================================================== -->
  <option gravity="0 0 0" timestep="0.002"/>

  <!-- Defaults: every joint and link geom inherits these unless overridden.
       Avoids repeating the same attributes on each body. -->
  <default>
    <joint type="hinge" axis="0 -1 0" damping="0"/>
    <geom  type="capsule" rgba="0.35 0.38 0.85 1"/>
  </default>

  <worldbody>

    <light name="top" pos="0 0 2" dir="0 0 -1"/>

    <!-- Visual reference only: a thin marker at the origin (the shoulder). -->
    <geom name="origin_marker" type="sphere" size="0.02" pos="0 0 0"
          rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>

    <!-- ---------------- LINK 1  (shoulder -> elbow) ---------------- -->
    <!-- Body origin sits at the SHOULDER, which is the world origin.
         This is frame {1} from the derivation. -->
    <body name="link1" pos="0 0 0">

      <!-- theta1: rotation of link 1 relative to the world.
           axis = (0,-1,0) so that a POSITIVE angle rotates +x toward +z,
           i.e. counter-clockwise when viewed with x right and z up.
           That matches the sign convention used in the hand derivation. -->
      <joint name="theta1" pos="0 0 0"/>

      <!-- The link itself: drawn along the body's own +x axis, length L1.
           This is the "x-axis points along the link" convention. -->
      <geom name="link1_geom" fromto="0 0 0  0.50 0 0" size="0.028"/>

      <!-- ---------------- LINK 2  (elbow -> club head) ---------------- -->
      <!-- Child body offset by L1 along link 1's own x-axis -> the elbow.
           This offset IS the translation column of the transform. -->
      <body name="link2" pos="0.50 0 0">

        <!-- theta2: measured RELATIVE to link 1, because this joint lives
             inside link 2, whose parent is link 1. MuJoCo's body nesting
             gives the "angles add along the chain" behaviour for free. -->
        <joint name="theta2" pos="0 0 0"/>

        <geom name="link2_geom" fromto="0 0 0  0.40 0 0" size="0.024"
              rgba="0.06 0.43 0.34 1"/>

        <!-- Tip marker at the far end of link 2 = the club head.
             A site is a massless, non-colliding reference point. We read
             its world position out of the simulation to verify the IK. -->
        <site name="tip" pos="0.40 0 0" size="0.035" type="sphere"
              rgba="0.94 0.60 0.48 1"/>

      </body>
    </body>

    <!-- Target marker: a non-colliding sphere we move to the desired (x,z)
         so we can see, visually, whether the tip actually lands on it. -->
    <body name="target" mocap="true" pos="0.6 0 0.3">
      <geom name="target_geom" type="sphere" size="0.03"
            rgba="0.75 0.35 0.29 0.6" contype="0" conaffinity="0"/>
    </body>

  </worldbody>

</mujoco>
