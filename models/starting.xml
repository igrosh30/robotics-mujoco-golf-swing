<mujoco model="IEO Humanoid body">

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="127" height="1278"
             rgb1="1 .35 .05" rgb2="1 .35 .05" markrgb="1 1 1" random="0.01"/>
    <material name="body" texture="body" texuniform="true" rgba="1 .35 .05 1"/>
    <material name="club" rgba="0.12 0.12 0.12 1"/>
    <material name="glass" rgba="0.1 0.2 0.3 0.8" reflectance="0.2"/>
    <mesh name="golf_club_mesh" file="golf_club.stl" scale="0.0085 0.0085 0.0085"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <default>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <default class="body">
      <geom type="capsule" condim="1" friction=".7" solimp=".9 .99 .003" solref=".015 1" material="body"/>
      <joint type="hinge" damping="15" stiffness="80" armature=".01" limited="true" solimplimit="0 .99 .01"/>
      <default class="big_joint">
        <joint damping="20" stiffness="100"/>
        <default class="big_stiff_joint">
          <joint damping="25" stiffness="140"/>
        </default>
      </default>
    </default>
  </default>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global offwidth="800" offheight="800"/>
  </visual>

  <worldbody>

    <!-- CHÃO -->
    <geom name="floor" type="plane" size="5 5 0.1" material="glass" contype="1" conaffinity="1"/>

    <body name="torso" pos="0 0 1.25" childclass="body">
      <camera name="back" pos="-3 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -3 1" xyaxes="1 0 0 0 1 2" mode="trackcom"/>
      <freejoint name="root"/>
      <geom name="torso" fromto="0 -.07 0 0 .07 0" size=".07"/>
      <geom name="upper_waist" fromto="-.01 -.06 -.12 -.01 .06 -.12" size=".06"/>

      <!-- CABEÇA -->
      <body name="head" pos="0 0 .19">
        <geom name="head" type="sphere" size=".09"/>
        <camera name="egocentric" pos=".09 0 0" xyaxes="0 -1 0 .1 0 1" fovy="80"/>
      </body>

      <!-- CINTURA -->
      <body name="lower_waist" pos="-.01 0 -.26">
        <geom name="lower_waist" fromto="0 -.06 0 0 .06 0" size=".06"/>
        <joint name="abdomen_z" pos="0 0 .065" axis="0 0 1" range="-45 45" class="big_stiff_joint"/>
        <joint name="abdomen_y" pos="0 0 .065" axis="0 1 0" range="-75 30" class="big_joint"/>

        <!-- PELVE -->
        <body name="pelvis" pos="0 0 -.165">
          <joint name="abdomen_x" pos="0 0 .1" axis="1 0 0" range="-35 35" class="big_joint"/>
          <geom name="butt" fromto="-.02 -.07 0 -.02 .07 0" size=".09"/>

          <!-- PERNA DIREITA FIXA -->
          <body name="right_thigh" pos="0 -.1 -.04">
            <geom name="right_thigh" fromto="0 0 0 0 .01 -.34" size=".06"/>
            <body name="right_shin" pos="0 .01 -.403">
              <geom name="right_shin" fromto="0 0 0 0 0 -.3" size=".049"/>
              <body name="right_foot" pos="0 0 -.39">
                <geom name="right_right_foot" fromto="-.07 -.02 0 .14 -.04 0" size=".027"/>
                <geom name="left_right_foot" fromto="-.07 0 0 .14 .02 0" size=".027"/>
              </body>
            </body>
          </body>

          <!-- PERNA ESQUERDA FIXA -->
          <body name="left_thigh" pos="0 .1 -.04">
            <geom name="left_thigh" fromto="0 0 0 0 -.01 -.34" size=".06"/>
            <body name="left_shin" pos="0 -.01 -.403">
              <geom name="left_shin" fromto="0 0 0 0 0 -.3" size=".049"/>
              <body name="left_foot" pos="0 0 -.39">
                <geom name="left_left_foot" fromto="-.07 .02 0 .14 .04 0" size=".027"/>
                <geom name="right_left_foot" fromto="-.07 0 0 .14 -.02 0" size=".027"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- BRAÇO DIREITO -->
      <body name="right_upper_arm" pos="0 -.17 .06">
        <joint name="right_shoulder1" axis="2 1 1" range="-85 60"/>
        <joint name="right_shoulder2" axis="0 -1 1" range="-85 60"/>
        <geom name="right_upper_arm" fromto="0 0 0 .16 -.16 -.16" size=".04 .16"/>
        <body name="right_lower_arm" pos=".18 -.18 -.18">
          <joint name="right_elbow" axis="1 0 0" range="-90 90" stiffness="0"/>
          <joint name="right_elbow_y" axis="0 1 0" range="-90 90" stiffness="0"/>
          <geom name="right_lower_arm" fromto=".01 .01 .01 .17 .17 .17" size=".031"/>
          <body name="right_hand" pos=".18 .18 .18">
            <!-- DOF DO PULSO: X E Y -->
            <joint name="right_wrist_x" axis="1 0 0" range="-45 45"/>
            <joint name="right_wrist_y" axis="0 1 0" range="-45 45"/>
            <geom name="right_hand" type="sphere" size=".04" zaxis="1 1 1"/>
            <!-- TACO DE GOLFE -->
            <geom
              name="golf_club"
              type="mesh"
              mesh="golf_club_mesh"
              material="club"
              pos="0.232 0 -0.889"
              contype="1"
              conaffinity="1"
            />
          </body>
        </body>
      </body>

      <!-- BRAÇO ESQUERDO -->
      <body name="left_upper_arm" pos="0 .17 .06">
        <joint name="left_shoulder1" axis="2 -1 1" range="-60 85"/>
        <joint name="left_shoulder2" axis="0 1 1" range="-60 85"/>
        <geom name="left_upper_arm" fromto="0 0 0 .16 .16 -.16" size=".04 .16"/>
        <body name="left_lower_arm" pos=".18 .18 -.18">
          <joint name="left_elbow" axis="1 0 0" range="-90 90" stiffness="0"/>
          <joint name="left_elbow_y" axis="0 1 0" range="-90 90" stiffness="0"/>
          <geom name="left_lower_arm" fromto=".01 -.01 .01 .17 -.17 .17" size=".031"/>
          <body name="left_hand" pos=".18 -.18 .18">
            <!-- DOF DO PULSO: X E Y -->
            <joint name="left_wrist_x" axis="1 0 0" range="-45 45"/>
            <joint name="left_wrist_y" axis="0 1 0" range="-45 45"/>
            <geom name="left_hand" type="sphere" size=".04" zaxis="1 -1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="abdomen_y_hold" joint="abdomen_y" kp="100"/>
    <position name="abdomen_z_hold" joint="abdomen_z" kp="100"/>
    <position name="abdomen_x_hold" joint="abdomen_x" kp="100"/>
    <position name="right_shoulder1_hold" joint="right_shoulder1" kp="60"/>
    <position name="right_shoulder2_hold" joint="right_shoulder2" kp="60"/>
    <position name="right_wrist_x_hold" joint="right_wrist_x" kp="40"/>
    <position name="right_wrist_y_hold" joint="right_wrist_y" kp="40"/>
    <position name="left_shoulder1_hold" joint="left_shoulder1" kp="60"/>
    <position name="left_shoulder2_hold" joint="left_shoulder2" kp="60"/>
    <position name="left_wrist_x_hold" joint="left_wrist_x" kp="40"/>
    <position name="left_wrist_y_hold" joint="left_wrist_y" kp="40"/>
  </actuator>

</mujoco>
